APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
# Hosted PostgreSQL: set DATABASE_URL instead of individual fields.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DBNAME=nexus
HOST=localhost
DB_PORT=5432
USER=postgres
PASSWORD=replace-me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173
CONNECTION_STRING=mongodb://localhost:27017/
DATABASE=nexus
COLECAO=contents
TMDB_KEY=replace-me
TWITCH_CLIENT_ID=replace-me
TWITCH_CLIENT_SECRET=replace-me
